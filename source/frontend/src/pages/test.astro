---
// Isolated rig for the HomePage hybrid flow, driven by the SAME
// section-slider.ts the home uses:
//   #testimonials (tall, natural scroll, fake "Quotes")
//   → lock at its end → slider: Reunions (3 cars) → Gallery
//   → exit → #stories (natural scroll)
// No Hero/Interlude/Lenis noise — just the scroll handoff to debug.
import "../styles/global.scss";
import Quotes from "../components/sections/Quotes/Quotes.astro";
import Gallery from "../components/sections/Gallery/Gallery.astro";
import ReunionsV2 from "../components/sections/ReunionsV2/ReunionsV2.astro";
import { t, type Locale } from "../i18n/utils";

const locale: Locale = "es";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test — hybrid section slider</title>
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body { background: #000; color: #fff; font-family: system-ui, sans-serif; }

      #stories-fake {
        height: 200vh;
        background: #1a1a1a;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding-top: 40vh;
        font-size: clamp(2rem, 8vw, 6rem);
        font-weight: 800;
      }

      /* Slider layers (same rule the home uses). */
      #reunions.slider-layer,
      #gallery.slider-layer {
        position: fixed !important;
        inset: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        min-height: 100vh !important;
        max-height: 100vh !important;
        z-index: 40;
        opacity: 0;
        visibility: hidden;
        overflow: hidden;
      }
      #reunions.slider-layer--active,
      #gallery.slider-layer--active {
        opacity: 1;
        visibility: visible;
        z-index: 41;
      }
      .layer #gallery,
      .layer #reunions { width: 100%; height: 100%; }
    </style>
  </head>
  <body>
    <script is:inline>
      window.__reunionsExternalControl = true;
    </script>

    {/* Real Quotes (section 4) — natural scroll, ends on SUBSTITUTE. */}
    <Quotes locale={locale} />

    <ReunionsV2 locale={locale} />

    <Gallery
      locale={locale}
      prevLabel={t(locale, "home.galleryPrev")}
      nextLabel={t(locale, "home.galleryNext")}
    />

    {/* Fake Stories. */}
    <section id="stories" data-section="stories">
      <div id="stories-fake">STORIES</div>
    </section>

    <canvas
      id="section-blob-canvas"
      style="position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:9999;opacity:0;"
    ></canvas>

    <script>
      import { initSectionSlider } from "../scripts/section-slider";
      if (document.readyState === "complete") initSectionSlider();
      else window.addEventListener("load", initSectionSlider, { once: true });
    </script>
  </body>
</html>
