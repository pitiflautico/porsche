---
// Scroll-control rig with the REAL Quotes section (4) as section 1.
// The controller clamps the scroll at the end of Quotes; an overscroll
// bar then fills with wheel effort to cross to section 2 (and back).
import "../styles/global.scss";
import Quotes from "../components/sections/Quotes/Quotes.astro";
import { type Locale } from "../i18n/utils";

const locale: Locale = "es";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test 2 — scroll clamp</title>
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { background: #000; color: #fff; font-family: system-ui, sans-serif; }

      /* Section 2 is OUT of the flow — it must never be reachable by
         scrolling. It only exists to prove the clamp works. */
      #sec2 {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #6a0a0a;
        font-size: clamp(2rem, 8vw, 6rem);
        font-weight: 800;
        opacity: 0;
        visibility: hidden;
        z-index: 5;
      }

      .readout {
        position: fixed;
        top: 16px;
        left: 16px;
        font-size: 12px;
        font-family: monospace;
        background: rgba(0,0,0,0.6);
        padding: 8px 12px;
        border-radius: 6px;
        z-index: 100;
        white-space: pre;
        line-height: 1.5;
      }

      /* Overscroll bar — appears once section 1 is at its end. Fills as
         the user keeps wheeling down; at 100% it crosses to section 2. */
      .overscroll-bar {
        position: fixed;
        left: 0;
        bottom: 0;
        width: 100%;
        height: 6px;
        background: rgba(255, 255, 255, 0.12);
        z-index: 200;
        opacity: 0;
        transition: opacity 0.2s ease;
      }
      .overscroll-bar.is-visible { opacity: 1; }
      .overscroll-fill {
        height: 100%;
        width: 0%;
        background: #fff;
        transition: width 0.08s linear;
      }
    </style>
  </head>
  <body>
    {/* Real Quotes (section 4) as the scrollable section 1. */}
    <Quotes locale={locale} />

    <section id="sec2">SECTION 2</section>

    <div class="readout" id="readout"></div>
    <div class="overscroll-bar" id="osbar"><div class="overscroll-fill" id="osfill"></div></div>

    <script>
      const sec1 = document.getElementById("testimonials")!; // real Quotes
      const sec2 = document.getElementById("sec2")!;
      const readout = document.getElementById("readout")!;
      const osbar = document.getElementById("osbar")!;
      const osfill = document.getElementById("osfill")!;

      // Extra "virtual travel" the user must wheel through at the end of
      // section 1 before it hands off — ~30% of the viewport, so there's
      // a clear, deliberate stretch of dead scroll before the change.
      function overscrollMax(): number {
        return Math.round(window.innerHeight * 0.4);
      }

      let overscroll = 0;
      let crossed = false; // true once we've handed off to section 2

      function maxScroll(): number {
        return sec1.offsetTop + sec1.offsetHeight - window.innerHeight;
      }
      function atEnd(): boolean {
        return window.scrollY >= maxScroll() - 1;
      }

      function clamp() {
        if (crossed) return;
        const max = maxScroll();
        if (window.scrollY > max) window.scrollTo({ top: max, behavior: "auto" });
      }

      function setBar(v: number) {
        const pct = Math.max(0, Math.min(1, v / overscrollMax()));
        osfill.style.width = pct * 100 + "%";
        osbar.classList.toggle("is-visible", pct > 0);
      }

      function goSection2() {
        crossed = true;
        overscroll = 0;
        setBar(0);
        sec2.style.opacity = "1";
        sec2.style.visibility = "visible";
      }

      function goSection1() {
        crossed = false;
        overscroll = 0;
        setBar(0);
        sec2.style.opacity = "0";
        sec2.style.visibility = "hidden";
        window.scrollTo({ top: maxScroll(), behavior: "auto" });
      }

      window.addEventListener("scroll", () => { clamp(); update(); }, { passive: true });

      window.addEventListener("wheel", (e) => {
        if (crossed) {
          // In section 2. Scroll is fully owned here: wheel-UP fills the
          // bar the other way and, at 100%, returns to section 1.
          e.preventDefault();
          if (e.deltaY < 0) {
            overscroll += -e.deltaY; // count upward intent
            if (overscroll >= overscrollMax()) goSection1();
            else setBar(overscroll);
          } else if (e.deltaY > 0 && overscroll > 0) {
            overscroll = Math.max(0, overscroll - e.deltaY);
            setBar(overscroll);
          }
          return;
        }
        // Section 1.
        if (e.deltaY > 0 && atEnd()) {
          // At the end: don't move the page — feed the overscroll bar.
          e.preventDefault();
          window.scrollTo({ top: maxScroll(), behavior: "auto" });
          overscroll += e.deltaY;
          if (overscroll >= overscrollMax()) goSection2();
          else setBar(overscroll);
        } else if (e.deltaY < 0 && overscroll > 0) {
          // Scrolling back up bleeds the bar back down.
          overscroll = Math.max(0, overscroll + e.deltaY);
          setBar(overscroll);
        }
      }, { passive: false });

      function update() {
        readout.textContent =
          "scrollY : " + Math.round(window.scrollY) + "\n" +
          "maxScroll: " + Math.round(maxScroll()) + "\n" +
          "atEnd   : " + atEnd() + "\n" +
          "overscroll: " + Math.round(overscroll) + " / " + Math.round(overscrollMax());
      }
      update();
      console.log("[test-2] scroll clamp + overscroll bar ready");
    </script>
  </body>
</html>
