      const scrollbarWidth =
        window.innerWidth - document.documentElement.clientWidth;
      document.body.style.overflow = "hidden";
      if (scrollbarWidth > 0)
        document.body.style.paddingRight = scrollbarWidth + "px";
      lenis()?.stop();

      gsap.set(personModal, { opacity: 1 });
      gsap.set(personModalBackdrop, { opacity: 0 });
      gsap.set(personModalContainer, { opacity: 0, y: 24, scale: 0.98 });
      gsap.to(personModalBackdrop, {
        opacity: 1,
        duration: 0.3,
        ease: "power2.out",
