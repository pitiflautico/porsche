      const countryEl = personModal.querySelector<HTMLElement>(
        ".reunion-person-modal__country",
      )!;
      const chapterEl = personModal.querySelector<HTMLElement>(
        ".reunion-person-modal__chapter",
      )!;
      if (dualWith) {
        nameEl.replaceChildren(
          document.createTextNode(`${nameOne} &`),
