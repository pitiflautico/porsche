---
import "./reunions.scss";
import CloseButton from "../../CloseButton/CloseButton.astro";
import { reunions } from "../../../data/reunions-data";
import type { Locale } from "../../../i18n/utils";

interface Props {
  locale: Locale;
  subtitle: string;
  title: string;
  ctaWatch: string;
  indicatorNav: string;
  indicatorDot: string;
  modalLabel: string;
  closeLabel: string;
  videoHeading: string;
  photoAlt: string;
  chapter: string;
  chapterShort: string;
  playAudioLabel: string;
  clickToPlayLabel: string;
  personModalDetailLabel: string;
  /**
   * When true, persons of the next reunion are hidden until the slide switches,
   * then enter with stagger. When false (default), they stay fully visible during
   * the WebGL transition and no stagger/blur runs on switch.
   */
  staggerPersonEntrance?: boolean;
}
const {
  locale,
  subtitle,
  title,
  ctaWatch,
  indicatorNav,
  indicatorDot,
  modalLabel,
  closeLabel,
  videoHeading,
  photoAlt,
  chapter,
  chapterShort,
  playAudioLabel,
  clickToPlayLabel,
  personModalDetailLabel,
  staggerPersonEntrance = false,
} = Astro.props;

const reunionCountry = (country: string, countryEn: string) =>
  locale === "en" ? countryEn : country;
const hasTooltipAudio = locale !== "en";
---

<section
  id="reunions"
  class="section reunions"
  data-section="reunions"
  data-play-audio-label={playAudioLabel}
  data-click-to-play-label={clickToPlayLabel}
  data-person-modal-detail-label={personModalDetailLabel}
  data-locale={locale}
  data-stagger-person-entrance={staggerPersonEntrance ? "true" : "false"}
  style={`--reunion-count: ${reunions.length}`}
>
  <div class="reunions__stage">
    <!-- WebGL canvas: handles images + dissolve transitions -->
    <canvas class="reunions__canvas" aria-hidden="true"></canvas>

    <!-- SVG hitbox overlays (one per reunion, stacked) -->
    <div class="reunions__hitboxes">
      {
        reunions.map((r, i) => (
          <svg
            class="reunion__people"
            data-reunion={r.id}
            data-reunion-index={String(i)}
            data-signatures={JSON.stringify(r.signature)}
            data-modal-photo-by-chapter={JSON.stringify(
              r.modalPhotoByChapter ?? {},
            )}
            data-country={reunionCountry(r.country, r.countryEn)}
            data-video={locale === "en" ? r.video.en || r.video.es : r.video.es}
            data-chapter-label={chapter}
            data-chapter-label-short={chapterShort}
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
            style={i > 0 ? "display:none" : undefined}
          >
            {r.people.map((p, pi) => (
              <g
                class="reunion__person"
                data-person-index={String(pi)}
                data-name={p.name}
                data-legend={` ${p.legend}`}
                data-chapter={String(p.chapter)}
                data-audio={p.audio ?? ""}
                data-quote={p.quote ?? ""}
                data-photo={p.photo ?? ""}
                data-tooltip-side={p.tooltipSide ?? ""}
                data-tooltip-offset-y={String(p.tooltipOffsetY ?? 0)}
                data-tooltip-left={
                  p.tooltipLeft != null ? String(p.tooltipLeft) : ""
                }
                data-tooltip-top={
                  p.tooltipTop != null ? String(p.tooltipTop) : ""
                }
                data-signature-max-height={
                  p.signatureMaxHeight != null
                    ? String(p.signatureMaxHeight)
                    : ""
                }
                data-cursor={hasTooltipAudio && p.audio ? "play" : "hide"}
                data-cursor-label={
                  hasTooltipAudio && p.audio ? clickToPlayLabel : undefined
                }
              >
                <rect x={p.x} y={p.y} width={p.width} height={p.height} />
              </g>
            ))}
          </svg>
        ))
      }
    </div>

    <!-- Text panel -->
    <div class="reunion">
      <nav class="reunion__indicator" aria-label={indicatorNav}>
        {
          reunions.map((r, i) => (
            <button
              class={`reunion__indicator-dot${i === 0 ? " is-active" : ""}`}
              aria-label={indicatorDot.replace("{n}", String(i + 1))}
              data-slide-index={String(i)}
            />
          ))
        }
      </nav>
      <div class="wrapper">
        <div class="wrapper__aside">
          <div class="reunion__data">
            <h2 class="subtitle" set:html={title} />
            <h3 class="reunion__location lead">
              <span class="reunion__location-country"></span>
            </h3>
            <div class="reunion__description">
              <h4 class="reunion__title lead" set:html={subtitle} />
              <p class="reunion__vin lead">
                <span class="reunion__vin-number"></span>
              </p>
            </div>

            <div class="reunion__chapters">
              <ul>
                <!-- Chapters are rendered dynamically by JS -->
              </ul>
            </div>
          </div>

          <div class="ctas">
            <button
              type="button"
              id="reunion-cta"
              class="btn btn--primary reunion__cta"
            >
              <span class="reunion__cta-icon" aria-hidden="true">
                <svg
                  width="1.2em"
                  height="1.2em"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  style="display:block;margin:auto;"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polygon points="10,8 16,12 10,16" fill="currentColor"
                  ></polygon>
                </svg>
              </span>
              {ctaWatch}
            </button>
          </div>
        </div>
        <div class="wrapper__main"></div>
      </div>
    </div>
  </div>
</section>

<!-- Tooltips are created dynamically by JS (pool) -->

<!-- Video modal -->
<div
  id="reunion-modal"
  class="reunion-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label={modalLabel}
>
  <div class="reunion-modal__backdrop" id="reunion-modal-backdrop"></div>
  <div class="reunion-modal__container" id="reunion-modal-container">
    <CloseButton
      id="reunion-modal-close"
      label={closeLabel}
      class="reunion-modal__close"
    />
    <div
      class="reunion-modal__video-wrap"
      id="reunion-modal-wrap"
      data-cursor="hide"
    >
      <!-- Loading overlay -->
      <div
        class="reunion-modal__loader"
        id="reunion-modal-loader"
        aria-live="polite"
        aria-label="Loading video"
      >
        <svg
          class="reunion-modal__spinner"
          viewBox="0 0 50 50"
          aria-hidden="true"
        >
          <circle
            class="reunion-modal__spinner-track"
            cx="25"
            cy="25"
            r="20"
            fill="none"
            stroke-width="2"></circle>
          <circle
            class="reunion-modal__spinner-fill"
            cx="25"
            cy="25"
            r="20"
            fill="none"
            stroke-width="2"></circle>
        </svg>
      </div>

      <!-- YouTube IFrame API mounts here -->
      <div id="reunion-yt-player" class="reunion-modal__player"></div>

      <!-- Pause info overlay -->
      <div class="reunion-modal__info" id="reunion-modal-info">
        <p
          class="reunion-modal__info-heading"
          id="reunion-modal-info-heading"
          data-label={videoHeading}
        >
        </p>
        <p class="reunion-modal__info-detail" id="reunion-modal-info-detail">
        </p>
      </div>

      <!-- Custom controls overlay -->
      <div
        class="reunion-modal__controls"
        id="reunion-modal-controls"
        aria-label="Video controls"
      >
        <div
          class="reunion-modal__progress-track"
          id="reunion-progress-track"
          role="slider"
          aria-label="Video progress"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="0"
          tabindex="0"
        >
          <div class="reunion-modal__progress-fill" id="reunion-progress-fill">
          </div>
          <div
            class="reunion-modal__progress-thumb"
            id="reunion-progress-thumb"
          >
          </div>
        </div>
        <div class="reunion-modal__ctrl-bar">
          <div class="reunion-modal__ctrl-left">
            <!-- Play / Pause -->
            <button
              class="reunion-modal__btn reunion-modal__btn--play"
              id="reunion-btn-play"
              aria-label="Play"
              type="button"
            >
              <svg
                class="reunion-modal__icon reunion-modal__icon--play"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                ><polygon points="8,5 19,12 8,19"></polygon></svg
              >
              <svg
                class="reunion-modal__icon reunion-modal__icon--pause"
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                ><rect x="6" y="4" width="4" height="16"></rect><rect
                  x="14"
                  y="4"
                  width="4"
                  height="16"></rect></svg
              >
            </button>
            <!-- Mute + Volume slider -->
            <div class="reunion-modal__vol-group">
              <button
                class="reunion-modal__btn reunion-modal__btn--mute"
                id="reunion-btn-mute"
                aria-label="Mute"
                type="button"
              >
                <svg
                  class="reunion-modal__icon reunion-modal__icon--vol"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  ><path d="M11 5 6 9H2v6h4l5 4V5z"></path><path
                    d="M15.54 8.46a5 5 0 0 1 0 7.07"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></path></svg
                >
                <svg
                  class="reunion-modal__icon reunion-modal__icon--muted"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                  ><path d="M11 5 6 9H2v6h4l5 4V5z"></path><line
                    x1="23"
                    y1="9"
                    x2="17"
                    y2="15"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></line><line
                    x1="17"
                    y1="9"
                    x2="23"
                    y2="15"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"></line></svg
                >
              </button>
              <input
                type="range"
                class="reunion-modal__vol-range"
                id="reunion-vol-range"
                min="0"
                max="100"
                value="100"
                aria-label="Volume"
              />
            </div>
            <!-- Time display -->
            <span class="reunion-modal__time" id="reunion-time" aria-live="off"
              >0:00 / 0:00</span
            >
          </div>
          <div class="reunion-modal__ctrl-right"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Person modal (mobile): tap chapter or silhouette opens this -->
<div
  id="reunion-person-modal"
  class="reunion-person-modal"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label=""
>
  <CloseButton
    id="reunion-person-modal-close"
    label={closeLabel}
    class="reunion-person-modal__close"
  />
  <div
    class="reunion-person-modal__backdrop"
    id="reunion-person-modal-backdrop"
  >
  </div>
  <div
    class="reunion-person-modal__container"
    id="reunion-person-modal-container"
  >
    <div class="reunion-person-modal__photo" hidden>
      <img class="reunion-person-modal__photo-img" src="" alt="" />
    </div>
    <div class="reunion-person-modal__content">
      <blockquote class="reunion-person-modal__quote" hidden></blockquote>
      <div class="reunion-person-modal__signature-wrap" hidden>
        <img
          class="reunion-person-modal__signature reunion-person-modal__signature--1"
          src=""
          alt=""
        />
        <img
          class="reunion-person-modal__signature reunion-person-modal__signature--2"
          src=""
          alt=""
          hidden
        />
      </div>
      <p class="reunion-person-modal__name-line">
        <span class="reunion-person-modal__name"></span>
      </p>
      <p class="reunion-person-modal__country"></p>
      <p class="reunion-person-modal__chapter"></p>
      <div class="reunion-person-modal__audio" hidden>
        <div class="reunion__tooltip-player">
          <button
            class="reunion__tooltip-playbtn reunion-person-modal__playbtn"
            type="button"
            aria-label={playAudioLabel}
          >
            <svg
              class="reunion__tooltip-icon reunion__tooltip-icon--play"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><polygon points="8,5 19,12 8,19"></polygon></svg
            >
            <svg
              class="reunion__tooltip-icon reunion__tooltip-icon--pause"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              ><rect x="6" y="4" width="4" height="16"></rect><rect
                x="14"
                y="4"
                width="4"
                height="16"></rect></svg
            >
          </button>
          <svg
            class="reunion__tooltip-waveform"
            viewBox="0 0 120 32"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="reunion__tooltip-wave reunion__tooltip-wave--main"
              d="M 0,16 L 120,16"></path>
            <path
              class="reunion__tooltip-wave reunion__tooltip-wave--core"
              d="M 0,16 L 120,16"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import {
    animateTextRandomBlur,
    animateTextRandomBlurOut,
  } from "../../../scripts/gsap-text-random-blur";
  import { reunions as reunionsData } from "../../../data/reunions-data";
  import {
    ReunionsCanvas,
    RippleEffect,
    ENABLE_REUNIONS_EFFECTS_DEBUG,
    getScrollState,
    isReunionsInteractionReady,
    type ScrollState,
    type ReunionImageSet,
  } from "../../../scripts/reunions/webgl-canvas";

  gsap.registerPlugin(ScrollTrigger);

  // ── GA4 + Floodlight helpers ───────────────────────────────────────────────
  type TrackW = typeof window & {
    gtag?: (...a: unknown[]) => void;
    floodlight?: {
      trackClick(el: string): void;
      trackVideo(el: string, m: string): void;
    };
  };
  const tw = window as TrackW;
  function ga4(name: string, params: Record<string, string>) {
    tw.gtag?.("event", name, { send_to: "G-VDKT3GY3Z3", ...params });
  }
  const fl = {
    click: (el: string) => tw.floodlight?.trackClick(el),
    video: (el: string, m: string) => tw.floodlight?.trackVideo(el, m),
  };
  function pId(n: string) {
    return (
      n
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/_+/g, "_")
        .replace(/^_|_$/g, "") || "unknown"
    );
  }

  function initReunions() {
    // Always start from the top — cinematic experiences are sequential.
    const lenisInit = (window as unknown as Record<string, unknown>).lenis as
      | { scrollTo: (pos: number, opts?: object) => void }
      | undefined;
    if (lenisInit) {
      lenisInit.scrollTo(0, { immediate: true });
    } else {
      window.scrollTo(0, 0);
    }

    const section = document.querySelector<HTMLElement>("#reunions");
    if (!section) return;

    const isEn = document.documentElement.lang === "en";

    const stage = section.querySelector<HTMLElement>(".reunions__stage");
    const panel = section.querySelector<HTMLElement>(".reunion");
    const canvasEl =
      section.querySelector<HTMLCanvasElement>(".reunions__canvas");
    const hitboxContainer = section.querySelector<HTMLElement>(
      ".reunions__hitboxes",
    );
    const hitboxSvgs =
      section.querySelectorAll<SVGSVGElement>(".reunion__people");
    if (!panel || !canvasEl || !hitboxContainer || !hitboxSvgs.length) return;

    const playLabel = section.dataset.playAudioLabel ?? "Play audio";
    const clickToPlayLabel =
      section.dataset.clickToPlayLabel ?? "Click to play";
    const detailLabel =
      section.dataset.personModalDetailLabel ?? "Person details";

    // ── WebGL Canvas ──────────────────────────────────────────────────────
    const ANCHOR_MAP: Record<string, number> = {
      mexico: 0.8,
      colombia: 0.75,
      peru: 0.95,
    };
    // Colombia: Federico (3) behind Pablo (2). Peru: person 3 behind person 2.
    const RENDER_ORDER: Record<string, number[]> = {
      colombia: [0, 1, 3, 2],
      peru: [0, 1, 3, 2, 4, 5],
    };
    const imageData: ReunionImageSet[] = reunionsData.map((r) => ({
      bg: window.innerWidth >= 1160 ? r.bgDesktop : r.bg,
      images: r.images,
      anchorX: ANCHOR_MAP[r.id] ?? 0.5,
      renderOrder: RENDER_ORDER[r.id],
    }));

    let webglCanvas: ReunionsCanvas | null = null;
    try {
      webglCanvas = new ReunionsCanvas(
        canvasEl,
        imageData,
        new RippleEffect(),
        {
          staggerPersonEntrance:
            section.dataset.staggerPersonEntrance === "true",
        },
      );
      if (ENABLE_REUNIONS_EFFECTS_DEBUG) webglCanvas.createDebugPanel();
    } catch {
      console.warn("WebGL not available, falling back to static display");
    }

    let currentReunionIndex = 0;
    const reunionCount = reunionsData.length;

    function getActiveSvg(): SVGSVGElement {
      return hitboxSvgs[currentReunionIndex] ?? hitboxSvgs[0];
    }

    /** Match WebGL cover rect to `.reunion__people` (same frame as CSS / hitboxes). */
    function syncCompositeLayout() {
      if (!webglCanvas) return;
      webglCanvas.syncCompositeRectToElement(getActiveSvg());
    }

    // Only show the first reunion's SVG hitbox initially
    hitboxSvgs.forEach((svg, i) => {
      svg.style.display = i === 0 ? "" : "none";
    });

    syncCompositeLayout();
    let compositeLayoutRoRaf = 0;
    if (typeof ResizeObserver !== "undefined" && stage) {
      const compositeLayoutRo = new ResizeObserver(() => {
        if (compositeLayoutRoRaf) cancelAnimationFrame(compositeLayoutRoRaf);
        compositeLayoutRoRaf = requestAnimationFrame(() => {
          compositeLayoutRoRaf = 0;
          syncCompositeLayout();
        });
      });
      compositeLayoutRo.observe(stage);
    }

    let resizeSyncRaf = 0;
    window.addEventListener("resize", () => {
      webglCanvas?.resize();
      if (resizeSyncRaf) cancelAnimationFrame(resizeSyncRaf);
      resizeSyncRaf = requestAnimationFrame(() => {
        resizeSyncRaf = 0;
        syncCompositeLayout();
      });
    });

    // ── Modal ──────────────────────────────────────────────────────────────
    const modal = document.getElementById("reunion-modal")!;
    const backdrop = document.getElementById("reunion-modal-backdrop")!;
    const closeBtn = document.getElementById("reunion-modal-close")!;
    const container = document.getElementById("reunion-modal-container")!;
    const wrap = document.getElementById("reunion-modal-wrap")!;
    const loader = document.getElementById("reunion-modal-loader")!;
    const progressTrack = document.getElementById("reunion-progress-track")!;
    const progressFill = document.getElementById("reunion-progress-fill")!;
    const progressThumb = document.getElementById("reunion-progress-thumb")!;
    const btnPlay = document.getElementById("reunion-btn-play")!;
    const btnMute = document.getElementById("reunion-btn-mute")!;
    const volRange = document.getElementById(
      "reunion-vol-range",
    ) as HTMLInputElement;
    const timeEl = document.getElementById("reunion-time")!;
    const cta = document.getElementById("reunion-cta")!;
    const infoHeading = document.getElementById("reunion-modal-info-heading")!;
    const infoDetail = document.getElementById("reunion-modal-info-detail")!;

    // Person modal (mobile only)
    const personModal = document.getElementById("reunion-person-modal")!;
    const personModalBackdrop = document.getElementById(
      "reunion-person-modal-backdrop",
    )!;
    const personModalContainer = document.getElementById(
      "reunion-person-modal-container",
    )!;
    const personModalClose = document.getElementById(
      "reunion-person-modal-close",
    )!;

    let activeVideoId = hitboxSvgs[0].dataset.video ?? "";

    // Video progress milestone tracking (reset on each video_open)
    const VIDEO_MILESTONES: Array<[number, string]> = [
      [0.25, "25%"],
      [0.5, "50%"],
      [0.75, "75%"],
    ];
    let milestonesFired = new Set<string>();

    type LenisInstance = { stop(): void; start(): void };
    const lenis = () =>
      (window as unknown as Record<string, LenisInstance>).lenis as
        | LenisInstance
        | undefined;

    let lastModalTrigger: HTMLElement | null = null;
    let closeTl: gsap.core.Timeline | null = null;
    let modalGen = 0;

    const mobileQuery = window.matchMedia("(max-width: 1023px)");
    function isMobile(): boolean {
      return mobileQuery.matches;
    }

    let personModalTrigger: HTMLElement | null = null;

    function openPersonModal(
      personG: SVGGElement,
      dualWith?: SVGGElement,
    ) {
      personModalTrigger = personG as unknown as HTMLElement;
      const svg = personG.closest<SVGSVGElement>(".reunion__people");
      const signatures: string[] = JSON.parse(
        svg?.dataset.signatures ?? "[]",
      ) as string[];

      const nameOne = personG.dataset.name ?? "";
      const nameTwo = dualWith?.dataset.name ?? "";
      const name = dualWith
        ? `${nameOne} & ${nameTwo}`
        : nameOne;
      const quote =
        (personG.dataset.quote ?? "").trim() ||
        (dualWith?.dataset.quote ?? "").trim();
      const audioUrl =
        personG.dataset.audio ?? dualWith?.dataset.audio ?? "";
      const chapterNum = parseInt(personG.dataset.chapter ?? "1", 10);
      const modalPhotoByChapter = JSON.parse(
        svg?.dataset.modalPhotoByChapter ?? "{}",
      ) as Record<string, string>;
      const dualModalPhoto =
        dualWith && modalPhotoByChapter[String(chapterNum)]
          ? modalPhotoByChapter[String(chapterNum)]
          : "";
      const photoUrl = dualWith
        ? dualModalPhoto
        : (personG.dataset.photo ?? "");
      const personIndex = parseInt(personG.dataset.personIndex ?? "0", 10);
      const sigUrl = signatures[personIndex] ?? "";

      personModal.setAttribute("aria-label", name || detailLabel);
      personModal.setAttribute("aria-hidden", "false");
      personModal.classList.add("is-open");

      const country = svg?.dataset.country ?? "";
      const chapterLabel = svg?.dataset.chapterLabel ?? "Chapter";
      const chapterText = `${chapterLabel} ${toRoman(chapterNum)}`;

      const photoWrap = personModal.querySelector<HTMLElement>(
        ".reunion-person-modal__photo",
      )!;
      const photoImg = personModal.querySelector<HTMLImageElement>(
        ".reunion-person-modal__photo-img",
      )!;
      if (photoUrl) {
        photoWrap.hidden = false;
        photoImg.src = photoUrl;
        photoImg.alt = name;
      } else {
        photoWrap.hidden = true;
      }

      const sigWrap = personModal.querySelector<HTMLElement>(
        ".reunion-person-modal__signature-wrap",
      )!;
      const sigImg1 = personModal.querySelector<HTMLImageElement>(
        ".reunion-person-modal__signature--1",
      )!;
      const sigImg2 = personModal.querySelector<HTMLImageElement>(
        ".reunion-person-modal__signature--2",
      )!;
      if (dualWith) {
        sigWrap.classList.add("reunion-person-modal__signature-wrap--dual");
        const idx2 = parseInt(dualWith.dataset.personIndex ?? "0", 10);
        const sigUrl2 = signatures[idx2] ?? "";
        const showSig = Boolean(sigUrl || sigUrl2);
        if (showSig) {
          sigWrap.hidden = false;
          if (sigUrl) {
            sigImg1.hidden = false;
            sigImg1.src = sigUrl;
            sigImg1.alt = "";
            const mh = personG.dataset.signatureMaxHeight;
            sigImg1.style.maxHeight = mh ? `${mh}px` : "";
          } else {
            sigImg1.hidden = true;
            sigImg1.removeAttribute("src");
          }
          if (sigUrl2) {
            sigImg2.hidden = false;
            sigImg2.src = sigUrl2;
            sigImg2.alt = "";
            const mh2 = dualWith.dataset.signatureMaxHeight;
            sigImg2.style.maxHeight = mh2 ? `${mh2}px` : "";
          } else {
            sigImg2.hidden = true;
            sigImg2.removeAttribute("src");
