---
import "./quotes.scss";
import { t, type Locale } from "../../../i18n/utils";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const country2 = t(locale, "quotes.2.country");
const country3 = t(locale, "quotes.3.country");
const country4 = t(locale, "quotes.4.country");
const country5 = t(locale, "quotes.5.country");
const country6 = t(locale, "quotes.6.country");
---

<section
  id="testimonials"
  class="section testimonials"
  data-section="testimonials"
>
  <div class="slogan">
    <div class="slogan__word">
      <span class="slogan__word-inner">THERE</span>
    </div>
    <div class="slogan__word"><span class="slogan__word-inner">IS</span></div>
    <div class="slogan__word"><span class="slogan__word-inner">NO</span></div>
    <div class="slogan__word">
      <span class="slogan__word-inner">SUBSTITUTE</span>
    </div>
  </div>
  <div class="quotes">
    <!-- Block image 1 -->
    <div class="quote">
      <picture class="quote__image quote__image--1">
        <img
          src={t(locale, "quotes.1.image")}
          alt={t(locale, "quotes.1.text")}
          title={t(locale, "quotes.1.author")}
        />
      </picture>
    </div>
    <!-- Block image and text 2, 3 -->
    <div class="quote" id="quote-block-2">
      <picture class="quote__image quote__image--2">
        <img
          src={t(locale, "quotes.2.image")}
          alt={t(locale, "quotes.2.text")}
          title={t(locale, "quotes.2.author")}
        />
      </picture>
      <blockquote class="quote__text quote__text--2">
        <p>{t(locale, "quotes.2.text")}</p>
        <cite class="quote__author"
          >&mdash; {t(locale, "quotes.2.author")}{
            country2 && (
              <>,<span class="quote__country"> {country2}</span></>
            )
          }</cite
        >
      </blockquote>
      <picture class="quote__image quote__image--3">
        <img
          src={t(locale, "quotes.3.image")}
          alt={t(locale, "quotes.3.text")}
          title={t(locale, "quotes.3.author")}
        />
      </picture>
      <blockquote class="quote__text quote__text--3">
        <p>{t(locale, "quotes.3.text")}</p>
        <cite class="quote__author"
          >&mdash; {t(locale, "quotes.3.author")}{
            country3 && (
              <>,<span class="quote__country"> {country3}</span></>
            )
          }</cite
        >
      </blockquote>
    </div>
    <!-- Block image and text 4, 5-->
    <div class="quote" id="quote-block-3">
      <picture class="quote__image quote__image--4">
        <img
          src={t(locale, "quotes.4.image")}
          alt={t(locale, "quotes.4.text")}
          title={t(locale, "quotes.4.author")}
        />
      </picture>
      <blockquote class="quote__text quote__text--4">
        <p>{t(locale, "quotes.4.text")}</p>
        <cite class="quote__author"
          >&mdash; {t(locale, "quotes.4.author")}{
            country4 && (
              <>,<span class="quote__country"> {country4}</span></>
            )
          }</cite
        >
      </blockquote>
      <picture class="quote__image quote__image--5">
        <img
          src={t(locale, "quotes.5.image")}
          alt={t(locale, "quotes.5.text")}
          title={t(locale, "quotes.5.author")}
        />
      </picture>
      <blockquote class="quote__text quote__text--5">
        <p>{t(locale, "quotes.5.text")}</p>
        <cite class="quote__author"
          >&mdash; {t(locale, "quotes.5.author")}{
            country5 && (
              <>,<span class="quote__country"> {country5}</span></>
            )
          }</cite
        >
      </blockquote>
    </div>
    <!-- Block image and text 6 -->
    <div class="quote quote--6" id="quote6">
      <blockquote class="quote__text quote__text--6">
        <p>{t(locale, "quotes.6.text")}</p>
        <cite class="quote__author"
          >&mdash; {t(locale, "quotes.6.author")}{
            country6 && (
              <>,<span class="quote__country"> {country6}</span></>
            )
          }</cite
        >
      </blockquote>
      <picture class="quote__image quote__image--6">
        <img
          src={t(locale, "quotes.6.image")}
          alt={t(locale, "quotes.6.text")}
          title={t(locale, "quotes.6.author")}
        />
      </picture>
    </div>
  </div>

</section>

<script>
  import {
    createParallaxAnimation,
    createElementParallax,
  } from "../../../utils/parallaxUtils.js";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  function initSloganAnimation() {
    const section = document.getElementById("testimonials");
    if (!section) return;

    const wordEls = gsap.utils.toArray<HTMLElement>(".slogan__word-inner");
    if (!wordEls.length) return;

    // Split each word into individual characters
    const splits = wordEls.map(
      (el) => new SplitText(el, { type: "chars", charsClass: "slogan__char" }),
    );

    // Hide all chars below their clip containers, tilted back on the X
    // axis so the entrance reads as "curved → flat" (chars come in
    // facing slightly downward and rotate up to face the camera).
    splits.forEach((split) => {
      gsap.set(split.chars, {
        yPercent: 115,
        rotateX: -65,
        transformPerspective: 900,
        transformOrigin: "50% 100%",
        filter: "blur(8px)",
        opacity: 0,
      });
    });

    let currentWord = -1;

    function wordIn(chars: Element[], delay = 0) {
      gsap.killTweensOf(chars);
      gsap.fromTo(
        chars,
        {
          yPercent: 115,
          rotateX: -65,
          transformPerspective: 900,
          transformOrigin: "50% 100%",
          filter: "blur(8px)",
          opacity: 0,
        },
        {
          yPercent: 0,
          rotateX: 0,
          filter: "blur(0px)",
          opacity: 1,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.055,
          delay,
        },
      );
    }

    function wordOut(chars: Element[], direction: "up" | "down" = "up") {
      gsap.killTweensOf(chars);
      gsap.to(chars, {
        yPercent: direction === "up" ? -110 : 110,
        rotateX: direction === "up" ? 65 : -65,
        filter: "blur(8px)",
        opacity: 0,
        duration: 0.5,
        ease: "power2.in",
        stagger: { each: 0.04, from: direction === "up" ? "start" : "end" },
      });
    }

    const wordContainers =
      section.querySelectorAll<HTMLElement>(".slogan__word");

    function showWord(index: number, scrollingDown: boolean) {
      const prev = currentWord;
      if (prev === index) return;
      currentWord = index;

      // Solo la palabra activa es visible; el resto oculta para que no se pisen
      wordContainers.forEach((el, i) => {
        el.classList.toggle("slogan__word--active", i === index);
      });

      if (prev >= 0) wordOut(splits[prev].chars, scrollingDown ? "up" : "down");
      if (index >= 0) wordIn(splits[index].chars, prev >= 0 ? 0.15 : 0);
    }

    // First word triggers when the section actually lands at the top
    // of the viewport (not 85% — at 85% the section is still hidden
    // behind the Interlude pin space, so the "THERE" entrance plays
    // off-screen and the user lands on already-finished text).
    ScrollTrigger.create({
      trigger: section,
      start: "top top",
      onEnter: () => showWord(0, true),
      onLeaveBack: () => {
        if (currentWord === 0) {
          wordOut(splits[0].chars, "down");
          currentWord = -1;
          wordContainers.forEach((el) =>
            el.classList.remove("slogan__word--active"),
          );
        }
      },
    });

    // Transitions at 25% / 50% / 75% of the 480vh section
    [
      { at: "20%", word: 1 }, // "IS"
      { at: "40%", word: 2 }, // "NO"
      { at: "70%", word: 3 }, // "SUBSTITUTE"
    ].forEach(({ at, word }) => {
      ScrollTrigger.create({
        trigger: section,
        start: `${at} top`,
        onEnter: () => showWord(word, true),
        onLeaveBack: () => showWord(word - 1, false),
      });
    });
  }

  // Parallax animation for the quotes container
  createParallaxAnimation("quote6", ".quote--6", 15, "yPercent");

  // Individual blockquote parallax
  createElementParallax("quote-block-2", ".quote__text--2", {
    movement: 150,
    direction: "up",
  });
  createElementParallax("quote-block-2", ".quote__text--3", {
    movement: 150,
    direction: "up",
  });
  createElementParallax("quote-block-3", ".quote__text--4", {
    movement: 150,
    direction: "up",
  });
  createElementParallax("quote-block-3", ".quote__text--5", {
    movement: 150,
    direction: "up",
  });
  createElementParallax("quote6", ".quote__text--6", {
    movement: 150,
    direction: "up",
  });

  function initQuoteTextReveals() {
    // Quote body text — chars cascade up with a micro-rotation.
    // Reversible: scroll down plays the reveal, scroll back up undoes it.
    const quotePs = gsap.utils.toArray<HTMLElement>(".quote__text > p");
    quotePs.forEach((el) => {
      const split = new SplitText(el, {
        type: "lines,chars",
        linesClass: "quote-line",
        charsClass: "quote-char",
      });

      gsap.set(split.chars, { yPercent: 30, opacity: 0, rotateZ: 6 });
      gsap.set(el, { filter: "blur(6px)" });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: el,
          start: "top 75%",
          toggleActions: "play none none reverse",
        },
      });
      tl.to(split.chars, {
        yPercent: 0,
        opacity: 1,
        rotateZ: 0,
        duration: 0.75,
        ease: "power3.out",
        stagger: 0.018,
      });
      tl.to(
        el,
        {
          filter: "blur(0px)",
          duration: 0.9,
          ease: "power2.out",
        },
        0,
      );
    });

    // Author / cite — words slide in horizontally, delayed after the quote text
    const quoteAuthors = gsap.utils.toArray<HTMLElement>(".quote__author");
    quoteAuthors.forEach((el) => {
      const split = new SplitText(el, {
        type: "words",
        wordsClass: "quote-author-word",
      });

      gsap.set(split.words, { xPercent: -30, opacity: 0 });

      gsap.to(split.words, {
        xPercent: 0,
        opacity: 1,
        duration: 0.85,
        ease: "power2.out",
        stagger: 0.1,
        delay: 0.5,
        scrollTrigger: {
          trigger: el,
          start: "top 75%",
          toggleActions: "play none none reverse",
        },
      });
    });
  }

  // Each .quote__image enters like a postcard arriving from a flat plane:
  // tilted back on the X axis + blurred + slightly smaller, then settles
  // flush to the camera, sharp and rectangular. Once landed, two parallax
  // layers run at different speeds:
  //   - The frame (.quote__image) drifts up at its own speed.
  //   - The inner photo drifts up at a different (faster) speed.
  // Each card has its own pair of speeds, so nothing moves in lockstep.
  function initImageCardEntrance() {
    const images = gsap.utils.toArray<HTMLElement>(".quote__image");

    // Force preserve-3d up the ancestor chain so rotateX renders in 3D
    // instead of being flattened by an intermediate stacking context.
    gsap.set(".testimonials, .quotes, .quote", {
      transformStyle: "preserve-3d",
    });

    images.forEach((picture) => {
      // Roller-shade entrance bound to the parent .quote (NOT the
      // picture itself). The picture is position:absolute with negative
      // top offsets — its getBoundingClientRect lives way above where
      // the user actually sees it, so triggers using the picture as
      // reference fired before Quotes was on screen and the scrub
      // landed at 100% (image already flat). .quote is position:relative
      // with min-height:100vh, so its bounding rect matches the visible
      // viewport position.
      const triggerEl = picture.closest<HTMLElement>(".quote") ?? picture;

      // True unroll: clip-path masks the image from the top down (so
      // the bottom edge appears first, then the rest "rolls out"), plus
      // a tilt + slight scaleY + blur that resolve as the image lands.
      // That combination reads as paper unfurling, not a flat resize.
      // True unroll: mask recedes from the BOTTOM (the top edge of the
      // image emerges first, then the rest unfolds downward — like a
      // blind dropping from a roller). Add a small rotateX + scaleY +
      // blur that all resolve as the unroll completes, so it reads as
      // paper unfurling, not a flat resize.
      // Image starts small, far back in the depth, lying face-DOWN on
      // a horizontal plane and pinned by its top edge — we only see
      // the line of its upper border from the front. As the user
      // scrolls, the bottom edge rotates DOWN toward the viewer and
      // the card unfurls from TOP to BOTTOM (because the top is
      // anchored by transformOrigin: center top). At the same time it
      // grows from scale 0.6 → 1 and pulls forward in z, so it reads
      // as "coming up from the back, unrolling top-down, landing flat
      // and frontal".
      gsap.fromTo(
        picture,
        {
          rotateX: -90,
          z: -200,
          scale: 0.6,
          opacity: 0,
          filter: "blur(10px)",
          transformPerspective: 800,
          transformOrigin: "center top",
        },
        {
          rotateX: 0,
          z: 0,
          scale: 1,
          opacity: 1,
          filter: "blur(0px)",
          ease: "sine.out",
          scrollTrigger: {
            trigger: triggerEl,
            start: "top 85%",
            end: "top 30%",
            scrub: 0.6,
            invalidateOnRefresh: true,
          },
        },
      );
    });
  }

  function bootQuotes() {
    initSloganAnimation();
    initQuoteTextReveals();
    initImageCardEntrance();
    // Run AFTER `load` (not just DOMContentLoaded) so Hero's pins
    // (which add ~320vh of pinSpacing) are already laid out — and
    // refresh once more for safety so every ScrollTrigger here picks
    // up the final document height.
    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  if (document.readyState === "complete") {
    bootQuotes();
  } else {
    window.addEventListener("load", bootQuotes, { once: true });
  }
</script>
